# ==========================================
# Tasko Backend Environment Configuration
# ==========================================

# Server Port
PORT=3000

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=tasko_db
DB_SYNC=true

# JWT Authentication Secrets & Expiration
JWT_ACCESS_SECRET=tasko_access_super_secret_key_2026_dev
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=tasko_refresh_super_secret_key_2026_dev
JWT_REFRESH_EXPIRES_IN=7d

# Brevo SMTP Configuration
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Tasko Team" <no-reply@tasko.vn>
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
